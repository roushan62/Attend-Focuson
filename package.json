{
  "name": "sitetrack",
  "version": "1.0.0",
  "private": true,
  "description": "SiteTrack — construction site attendance & workforce management built entirely on Google Sheets + Apps Script. Zero npm dependencies: the scripts below run on plain Node.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node dev/server.mjs",
    "test": "node dev/smoke-test.mjs",
    "verify": "node dev/verify.mjs",
    "check": "node dev/verify.mjs && node dev/smoke-test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dev/data',{recursive:true,force:true});require('node:fs').rmSync('dev/data-test',{recursive:true,force:true});console.log('local harness state cleared')\""
  }
}
