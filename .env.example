# ------------------------------------------------------------------
# SiteAttend environment — copy to .env.local and fill in ONE backend.
# With NO backend configured the app runs on a local demo database
# (.data/db.json) so you can try it immediately.
# ------------------------------------------------------------------

# ============ OPTION A (recommended): Google Apps Script ============
# No Cloud Console, no service account, no JSON key — just the Sheet +
# google-apps-script/Code.gs. Follow SETUP.md §2A (~10 min, free).
# Web App /exec URL from Deploy ▸ Web app:
APPS_SCRIPT_URL=
# same long random string you pasted into SECRET inside Code.gs:
APPS_SCRIPT_SECRET=

# ============ OPTION B: Service account + Sheets API ============
# Google Sheet "AttendanceDB" — the part between /d/ and /edit in the sheet URL
GOOGLE_SHEET_ID=
# Service account email (from the downloaded key JSON: "client_email")
GOOGLE_CLIENT_EMAIL=
# Private key from the key JSON. Keep the \n escapes, wrap in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"

# ============ required for both ============
# Secret used to sign login session cookies. Use any long random string.
# Generate:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string
