# ------------------------------------------------------------------
# SiteAttend environment — copy to .env.local and fill in.
# WITHOUT these three values the app runs on a local demo database
# (.data/db.json) so you can try it immediately. With them set,
# everything is stored in your Google Sheet — zero DB cost.
# ------------------------------------------------------------------

# Google Sheet "AttendanceDB" — the part between /d/ and /edit in the sheet URL
GOOGLE_SHEET_ID=
# Service account email (from the downloaded key JSON: "client_email")
GOOGLE_CLIENT_EMAIL=
# Private key from the key JSON. Keep the \n escapes, wrap in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# Secret used to sign login session cookies. Use any long random string.
# Generate:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string
